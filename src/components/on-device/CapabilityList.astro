---
import { capabilitiesIn, type CapabilityGroup } from "@/data/capabilities";
import { getI18n } from "@/i18n";

interface Props {
  group: CapabilityGroup;
}

const { t } = getI18n(Astro);
const { group } = Astro.props;
---

{/* The capabilities a demo stands for, each with the model that runs it. */}
<ul class="mt-6 grid gap-x-10 sm:grid-cols-2">
  {capabilitiesIn(group).map(({ id, model }) => (
    <li class="flex items-baseline justify-between gap-4 border-t border-line py-3">
      <span class="text-body-sm text-ink">{t.onDevice.capabilities[id]}</span>
      <span class="text-end text-caption text-ink-subtle">{model ?? t.onDevice.composedModel}</span>
    </li>
  ))}
</ul>
