---
import { Icon } from "astro-icon/components";

import { searchScores } from "@/data/sample";
import { getI18n } from "@/i18n";
import { tv } from "@/lib/tv";

/*
 * Find: a search by meaning across the sample Space. The question shares almost no words with the
 * passage it finds; the first result shows the passage it matched. Scores are the sample's facts,
 * drawn as bars so the ranking reads at a glance.
 */
const { canvas, onDevice } = getI18n(Astro).t;

const results = [
  {
    icon: "audio-lines",
    kind: canvas.recording.kind,
    title: canvas.recording.title,
    passage: onDevice.listen.lines[1],
  },
  { icon: "globe", kind: canvas.capture.kind, title: canvas.capture.title },
  { icon: "file-text", kind: canvas.document.kind, title: canvas.document.title },
].map((result, index) => ({ ...result, score: searchScores[index] ?? 0 }));

const row = tv({
  base: "result rounded-md px-3.5 py-3",
  variants: { best: { true: "bg-ink/6" } },
});
---

<div class="flex h-full flex-col px-5 pt-5 sm:px-6 sm:pt-6" data-find>
  <p class="flex items-center gap-3 rounded-md border border-line-strong bg-ink/4 px-4 py-3 text-body-sm text-ink">
    <Icon name="lucide:search" class="size-4 shrink-0 text-ink-subtle" aria-hidden="true" />
    <span class="min-w-0">
      <span data-query>{onDevice.find.query}</span>
      <span class="caret" aria-hidden="true"></span>
    </span>
    <span class="ml-auto shrink-0 rounded-sm border border-line-strong px-2 py-0.5 text-caption text-ink-muted">
      {onDevice.find.mode}
    </span>
  </p>

  <ol class="mt-4 grid gap-1.5">
    {results.map((result, index) => (
      <li class={row({ best: index === 0 })}>
        <div class="flex items-center gap-3">
          <span class="grid size-8 shrink-0 place-items-center rounded-sm bg-ink/8 text-ink-muted">
            <Icon name={`lucide:${result.icon}`} class="size-4" aria-hidden="true" />
          </span>
          <span class="min-w-0">
            <span class="block text-body-sm font-medium text-ink">{result.title}</span>
            <span class="block text-caption text-ink-subtle">{result.kind}</span>
          </span>
          <span class="ml-auto flex shrink-0 items-center gap-2.5">
            <svg viewBox="0 0 100 4" class="hidden h-1 w-14 sm:block" aria-hidden="true">
              <rect width="100" height="4" rx="2" class="fill-ink/10"></rect>
              <rect width={result.score * 100} height="4" rx="2" class="fill-accent"></rect>
            </svg>
            <span class="font-mono text-caption text-ink-muted tabular-nums">{result.score.toFixed(2)}</span>
          </span>
        </div>
        {result.passage && (
          <p class="mt-2.5 ml-11 border-l-2 border-accent pl-3 text-body-sm text-ink-muted">
            {result.passage}
          </p>
        )}
      </li>
    ))}
  </ol>
</div>

<style>
  .caret {
    display: none;
    width: 1.5px;
    height: 1.1em;
    margin-inline-start: 1px;
    vertical-align: -0.2em;
    background-color: var(--color-accent);
  }

  [data-find][data-typing] .caret {
    display: inline-block;
    animation: caret 1s steps(1) infinite;
  }

  .result {
    transition:
      opacity 500ms var(--ease-standard),
      translate 500ms var(--ease-standard);
  }

  .result:nth-child(2) {
    transition-delay: 90ms;
  }

  .result:nth-child(3) {
    transition-delay: 180ms;
  }

  [data-find][data-typing] .result {
    opacity: 0;
    translate: 0 0.5rem;
    transition-duration: 0ms;
    transition-delay: 0ms;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  import { sleep, whileShown } from "@/scripts/playback";

  /** The rhythm of one search: a keystroke, the pause before results, and how long they show. */
  const KEYSTROKE_MS = 55;
  const THINK_MS = 350;
  const SHOW_MS = 6500;

  for (const root of document.querySelectorAll<HTMLElement>("[data-find]")) {
    const query = root.querySelector<HTMLElement>("[data-query]");
    if (!query) continue;
    const text = query.textContent;
    // Graphemes, not UTF-16 units, so a character is never split mid-way.
    const characters = [...new Intl.Segmenter(document.documentElement.lang).segment(text)].map(
      (part) => part.segment,
    );

    const search = async (signal: AbortSignal) => {
      for (;;) {
        root.toggleAttribute("data-typing", true);
        for (let typed = 0; typed <= characters.length; typed++) {
          query.textContent = characters.slice(0, typed).join("");
          await sleep(KEYSTROKE_MS, signal);
        }
        await sleep(THINK_MS, signal);
        root.toggleAttribute("data-typing", false);
        await sleep(SHOW_MS, signal);
      }
    };

    whileShown(root, () => {
      const controller = new AbortController();
      search(controller.signal).catch((error: unknown) => {
        if (!controller.signal.aborted) throw error;
      });
      return () => {
        controller.abort();
        root.toggleAttribute("data-typing", false);
        query.textContent = text;
      };
    });
  }
</script>
