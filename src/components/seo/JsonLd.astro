---
import type { Thing, WithContext } from "schema-dts";

interface Props {
  description: WithContext<Thing>;
}

// `<` is escaped so that no string in the description can close the script element early.
const json = JSON.stringify(Astro.props.description).replaceAll("<", "\\u003c");
---

<script type="application/ld+json" is:inline set:html={json} />
