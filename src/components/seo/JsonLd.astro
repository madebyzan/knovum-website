---
import type { Thing, WithContext } from "schema-dts";

interface Props {
  data: WithContext<Thing>;
}

// `<` is escaped so that no string in the data can close the script element early.
const json = JSON.stringify(Astro.props.data).replaceAll("<", "\\u003c");
---

<script type="application/ld+json" is:inline set:html={json} />
