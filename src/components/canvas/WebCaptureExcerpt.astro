---
import { getI18n } from "@/i18n/page-language";

import CanvasNode from "./CanvasNode.astro";
import ObjectClassification from "./ObjectClassification.astro";

interface Props {
  class: string;
}

const { capture } = getI18n(Astro).t.canvas;
---

<CanvasNode class={Astro.props.class}>
  <div class="-mx-4.5 -mt-4 mb-3.5 grid h-21 content-center gap-2.5 border-b border-line bg-paper-muted px-4.5">
    <span class="h-2.5 w-[46%] rounded-full bg-ink/20"></span>
    <span class="h-1.75 w-[72%] rounded-full bg-ink/12"></span>
    <span class="h-1.75 w-[60%] rounded-full bg-ink/12"></span>
  </div>
  <ObjectClassification icon="globe" label={capture.kind} aside={capture.source} />
  <p class="mb-1.5 text-canvas-lg leading-snug font-semibold text-ink">{capture.title}</p>
  <p class="text-ink-muted">{capture.body}</p>
</CanvasNode>
