---
import { citedMoment } from "@/data/sample";
import { getI18n } from "@/i18n";

import CanvasCard from "./CanvasCard.astro";
import CardKind from "./CardKind.astro";
import Waveform from "./Waveform.astro";

interface Props {
  class: string;
}

const { recording } = getI18n(Astro).t.canvas;
---

<CanvasCard class={Astro.props.class}>
  <CardKind icon="audio-lines" label={recording.kind} aside={recording.duration} />
  <Waveform highlight={citedMoment.waveform} class="mb-3 h-9.5" />
  <p class="text-ink">{recording.quote}</p>
  <p class="mt-2 font-mono text-canvas-xs text-ink-subtle">{citedMoment.at}</p>
</CanvasCard>
