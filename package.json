{
  "name": "knovum-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev:website": "pnpm --filter @knovum/website dev",
    "dev:docs": "pnpm --filter @knovum/documentation dev",
    "build": "pnpm -r --if-present build",
    "build:website": "pnpm --filter @knovum/website build",
    "build:docs": "pnpm --filter @knovum/documentation build",
    "check": "pnpm format:check && pnpm test:architecture && pnpm -r --if-present check",
    "verify": "pnpm check && pnpm -r --if-present test:e2e && pnpm -r --if-present validate:html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:architecture": "node --test tooling/__tests__/*.test.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3"
  }
}
