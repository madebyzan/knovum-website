{
  "name": "@knovum/website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "pnpm -w format",
    "format:check": "pnpm -w format:check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "knip": "knip",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run knip",
    "verify": "pnpm run check && pnpm run test:e2e && pnpm run validate:html",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.13.0",
    "html-validate": "11.17.0",
    "knip": "6.42.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "schema-dts": "2.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@github/tab-container-element": "4.9.0",
    "@iconify-json/lucide": "1.2.147",
    "@iconify-json/simple-icons": "1.2.100",
    "@iconify/utils": "3.1.7",
    "@lobehub/icons-static-svg": "1.97.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "astro-icon": "1.2.0",
    "motion": "14.5.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3"
  },
  "description": "The Knovum website."
}
