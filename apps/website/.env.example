# Copy to `.env` for local work. CI and deploys set these in the environment instead.

# The origin every absolute URL is built on. Required.
SITE_URL=http://localhost:4321

# Build from the recorded release instead of GitHub's latest. Deploys leave this unset.
RELEASE_FILE=tests/fixtures/release.json

# Optional: raises GitHub's API rate limit when reading the live release.
# GITHUB_TOKEN=

# Optional: enables Cloudflare Web Analytics.
# CLOUDFLARE_ANALYTICS_TOKEN=

DOCS_URL=https://docs.example.com
