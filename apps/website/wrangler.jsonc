{
  // Static assets only: Cloudflare serves the built site from its edge, no Worker code runs.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knovum-website",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
