---
import { SECTION_IDS } from "@/config/navigation";
import { getI18n } from "@/i18n/page-language";
import { documentationUrl } from "@/lib/documentation";

import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const { locale, t } = getI18n(Astro);
const id = SECTION_IDS.questions;
---

<Section id={id} labelledBy={`${id}-title`} divided>
  <div class="grid gap-x-12 gap-y-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <SectionHeading id={`${id}-title`} title={t.questions.title} />
      <a
        class="mt-8 inline-flex items-center gap-2 text-body-sm font-medium text-ink underline-offset-4 hover:underline"
        href={documentationUrl(locale, "/reference/faq/")}
      >
        {t.questions.more}
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="border-b border-line lg:col-span-8">
      {t.questions.items.map(({ question, answer }) => (
        <details class="group border-t border-line">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-8 py-6 text-subheading [&::-webkit-details-marker]:hidden">
            {question}
            <span
              class="mt-1 shrink-0 font-mono text-ink-subtle transition-transform duration-200 group-open:rotate-45 motion-reduce:transition-none"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="max-w-measure pb-8 text-body text-ink-muted">{answer}</p>
        </details>
      ))}
    </div>
  </div>
</Section>
