---
import { SECTION_IDS } from "@/config/navigation";
import { modelOperations } from "@/data/model-operations";
import { getI18n } from "@/i18n/page-language";

import OnDeviceShowcase from "../on-device/OnDeviceShowcase.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const { t } = getI18n(Astro);
const { onDevice } = t;
const id = SECTION_IDS.onDeviceAi;
---

<Section id={id} labelledBy={`${id}-title`} tone="inverse">
  <OnDeviceShowcase>
    <SectionHeading
      id={`${id}-title`}
      kicker={onDevice.kicker(modelOperations.length)}
      title={onDevice.title}
      lead={onDevice.lead}
    />
  </OnDeviceShowcase>

  <p class="mt-10 text-label text-ink-subtle lg:mt-14" data-reveal>
    {onDevice.note}
  </p>
</Section>
