---
import { tv, type VariantProps } from "@/lib/style-variants";

const nodeAppearance = tv({
  slots: {
    root: "shadow-canvas-nodeAppearance absolute overflow-hidden rounded-canvas-lg bg-surface px-4.5 py-4 motion-safe:animate-settle",
    handle:
      "absolute size-2 rounded-canvas-xs border-[length:calc(var(--spacing)*0.375)] border-accent bg-surface",
  },
  variants: {
    selected: { true: { root: "overflow-visible shadow-canvas-selected" } },
  },
});

type Props = VariantProps<typeof nodeAppearance> & {
  /** Position and size on the 1440-unit stage, and the nodeAppearance's `enter-*` step in the canvas's entrance. */
  class: string;
};

const { selected = false, class: geometry } = Astro.props;
const styles = nodeAppearance({ selected });
const corners = [
  "-top-1.25 -left-1.25",
  "-top-1.25 -right-1.25",
  "-bottom-1.25 -left-1.25",
  "-right-1.25 -bottom-1.25",
];
---

<div class={styles.root({ class: geometry })}>
  <slot />
  {selected && corners.map((corner) => <span class={styles.handle({ class: corner })} />)}
</div>
