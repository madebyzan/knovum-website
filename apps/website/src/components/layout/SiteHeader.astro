---
import { documentationUrl } from "@/lib/documentation";
import { Icon } from "astro-icon/components";

import { PRIMARY_SECTIONS } from "@/config/navigation";
import { externalLinks } from "@/config/site";
import { getI18n, homePath, sectionPath } from "@/i18n/page-language";

import ActionLink from "../ui/ActionLink.astro";
import Brand from "../ui/Brand.astro";
import Container from "../ui/Container.astro";
import { navLink } from "../ui/variants";
import LocaleSwitch from "./LocaleSwitch.astro";
import SiteMenu from "./SiteMenu.astro";

const { locale, t } = getI18n(Astro);
const documentationHome = documentationUrl(locale);
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/80 backdrop-blur-xl backdrop-saturate-150">
  <Container class="flex h-header items-center gap-10">
    <a href={homePath(locale)} class="-m-1 rounded-md p-1">
      <Brand />
    </a>

    <nav aria-label={t.a11y.primaryNavigation} class="hidden md:block">
      <ul class="flex gap-8">
        {PRIMARY_SECTIONS.map((section) => (
          <li>
            <a class={navLink({ class: "text-body-sm" })} href={sectionPath(locale, section)}>
              {t.nav.sections[section]}
            </a>
          </li>
        ))}
        <li>
          <a class={navLink()} href={documentationHome}>
            {t.nav.documentation}
          </a>
        </li>
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-5">
      <LocaleSwitch class="max-md:hidden" />
      <a
        class={navLink({ class: "inline-flex max-md:hidden" })}
        href={externalLinks.github}
        aria-label="GitHub"
      >
        <Icon name="simple-icons:github" class="size-5" aria-hidden="true" />
      </a>
      <ActionLink href={sectionPath(locale, "download")} size="sm">
        {t.nav.download}
      </ActionLink>
      <SiteMenu />
    </div>
  </Container>
</header>
