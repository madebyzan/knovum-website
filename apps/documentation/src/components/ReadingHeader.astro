---
/**
 * Page title for every document except a locale's front page, which carries its own introduction.
 * The category is the sidebar group the page belongs to, so it always matches the navigation.
 */
import PageTitle from "@astrojs/starlight/components/PageTitle.astro";
import { readingMinutes } from "@/lib/reading-time";

type SidebarEntry = (typeof Astro.locals.starlightRoute.sidebar)[number];

const { entry, id, lang, locale, sidebar } = Astro.locals.starlightRoute;
const isFrontPage = id === (locale ?? "");
const chinese = lang === "zh-CN";

function containsCurrent(entries: readonly SidebarEntry[]): boolean {
  return entries.some((item) => (item.type === "link" ? item.isCurrent : containsCurrent(item.entries)));
}
const category = sidebar.find((item) => item.type === "group" && containsCurrent(item.entries))?.label;
const minutes = readingMinutes(entry.body ?? "");
---

{!isFrontPage && (
  <div class="reading-header">
    <div class="reading-context">
      {category && <span>{category}</span>}
      <span>{chinese ? `约 ${String(minutes)} 分钟` : `${String(minutes)} min read`}</span>
    </div>
    <PageTitle />
    {entry.data.description && <p class="reading-summary">{entry.data.description}</p>}
  </div>
)}
<style>
  .reading-context {
    display: flex;
    gap: 1rem;
    align-items: center;
    color: var(--sl-color-gray-3);
    font-size: 0.8rem;
  }
  .reading-context span + span {
    border-inline-start: 1px solid var(--sl-color-hairline);
    padding-inline-start: 1rem;
  }
  .reading-summary {
    margin-top: 1rem;
    max-width: 40rem;
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--sl-color-gray-2);
  }
</style>
